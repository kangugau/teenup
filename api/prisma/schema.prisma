// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Parent {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String?
  email    String    @unique
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id            Int      @id @default(autoincrement())
  name          String
  dob           DateTime
  gender        String
  currentGrade  String   @map("current_grade")
  parentId      Int      @map("parent_id")
  parent        Parent   @relation(fields: [parentId], references: [id])
  
  registrations ClassRegistration[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id            Int      @id @default(autoincrement())
  name          String
  subject       String
  dayOfWeek     String   @map("day_of_week")
  timeSlot      String   @map("time_slot")
  teacherName   String   @map("teacher_name")
  maxStudents   Int      @map("max_students")

  registrations ClassRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassRegistration {
  id        Int     @id @default(autoincrement())
  classId   Int     @map("class_id")
  studentId Int     @map("student_id")
  class     Class   @relation(fields: [classId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, studentId])
}

model Subscription {
  id             Int      @id @default(autoincrement())
  studentId      Int      @map("student_id")
  student        Student  @relation(fields: [studentId], references: [id])
  packageName    String   @map("package_name")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  totalSessions  Int      @map("total_sessions")
  usedSessions   Int      @map("used_sessions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
